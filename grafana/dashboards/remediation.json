{
  "dashboard": {
    "id": null,
    "title": "OpsGuard — Remediation",
    "tags": ["opsguard", "remediation"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {"from": "now-24h", "to": "now"},
    "panels": [
      {
        "id": 1,
        "title": "Remediation Actions by Type",
        "type": "barchart",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [{"expr": "sum by (action_type) (opsguard_remediation_actions_total)"}]
      },
      {
        "id": 2,
        "title": "Remediation Success Rate",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [{"expr": "sum by (result) (opsguard_remediation_actions_total)"}]
      },
      {
        "id": 3,
        "title": "Verification Runs",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
        "targets": [{"expr": "rate(opsguard_verification_runs_total[5m])", "legendFormat": "Verifications"}]
      }
    ]
  }
}
