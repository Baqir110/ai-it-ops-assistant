{
  "dashboard": {
    "id": null,
    "title": "OpsGuard — Service Reliability",
    "tags": ["opsguard", "reliability"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {"from": "now-24h", "to": "now"},
    "panels": [
      {
        "id": 1,
        "title": "Service Availability",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "targets": [{"expr": "opsguard_http_checks_total{result=\"success\"} / opsguard_http_checks_total", "legendFormat": "{{service}}"}]
      },
      {
        "id": 2,
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [{"expr": "rate(opsguard_http_checks_total{result=\"failure\"}[5m]) / rate(opsguard_http_checks_total[5m]) * 100", "legendFormat": "{{service}}"}]
      },
      {
        "id": 3,
        "title": "p95 Latency",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [{"expr": "histogram_quantile(0.95, rate(opsguard_http_check_latency_seconds_bucket[5m]))", "legendFormat": "{{service}}"}]
      }
    ]
  }
}
