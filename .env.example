# OpsGuard Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env.

# ── Core ─────────────────────────────────────────────────────────────
PROJECT_NAME=OpsGuard
APP_VERSION=2.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://ops:ops@localhost:5432/ops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin

# ── AI / LLM ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=false

# ── RAG / Vector Store ───────────────────────────────────────────────
VECTOR_STORE_PATH=./data/chroma_db
RUNBOOKS_PATH=./data/runbooks
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── HTTP Monitor ─────────────────────────────────────────────────────
HTTP_MONITOR_INTERVAL_SECONDS=30
HTTP_MONITOR_TIMEOUT_SECONDS=5.0
HTTP_MONITOR_FAILURE_THRESHOLD=3
HTTP_MONITOR_LATENCY_THRESHOLD_MS=2000.0

# ── Prometheus ───────────────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_ENABLED=true
PROMETHEUS_QUERY_TIMEOUT=10.0

# ── Detection Thresholds ─────────────────────────────────────────────
CPU_THRESHOLD=85.0
RAM_THRESHOLD=85.0
DISK_THRESHOLD=90.0
HTTP_ERROR_RATE_THRESHOLD=5.0
HTTP_LATENCY_P95_THRESHOLD_MS=500.0
SSL_CERT_EXPIRY_DAYS=14

# ── Incident Management ──────────────────────────────────────────────
INCIDENT_AUTO_RESOLVE_ENABLED=true
INCIDENT_DEDUP_WINDOW_MINUTES=30
EVIDENCE_COLLECTION_TIMEOUT=30.0
VERIFICATION_INTERVAL_SECONDS=15
VERIFICATION_MAX_ATTEMPTS=5

# ── Remediation ──────────────────────────────────────────────────────
REMEDIATION_AUTO_APPROVE_LOW_RISK=false
REMEDIATION_MAX_RETRIES=2

# ── SLO ──────────────────────────────────────────────────────────────
SLO_EVALUATION_INTERVAL_SECONDS=300

# ── Cost ─────────────────────────────────────────────────────────────
COST_ANALYSIS_INTERVAL_SECONDS=3600

# ── Security ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_REQUESTS_PER_MINUTE=60
AUDIT_LOG_RETENTION_DAYS=365

# ── Observability ────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOKI_URL=http://localhost:3100
LOKI_ENABLED=false

# ── Failure Simulator (DEV ONLY) ─────────────────────────────────────
FAILURE_SIMULATOR_ENABLED=false
